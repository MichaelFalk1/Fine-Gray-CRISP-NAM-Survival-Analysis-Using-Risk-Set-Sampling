\@writefile{toc}{\contentsline {subsection}{\numberline {4.4.1}Ground Truth Risk Recovery}{40}{subsection.4.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.16}{\ignorespaces Model diagnostics for the Full Cohort on the synthetic dataset. The left panel demonstrates strong ground truth risk recovery (Pearson $r=0.843$). The right panel confirms absolute probabilistic accuracy, with the model's predicted Cumulative Incidence Functions closely tracking the empirical Aalen-Johansen estimates across three distinct risk strata.}}{40}{figure.caption.35}\protected@file@percent }
\newlabel{fig:synth_truth_recovery}{{4.16}{40}{Model diagnostics for the Full Cohort on the synthetic dataset. The left panel demonstrates strong ground truth risk recovery (Pearson $r=0.843$). The right panel confirms absolute probabilistic accuracy, with the model's predicted Cumulative Incidence Functions closely tracking the empirical Aalen-Johansen estimates across three distinct risk strata}{figure.caption.35}{}}
\newlabel{fig:synth_truth_recovery@cref}{{[figure][16][4]4.16}{[1][40][]40}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4.2}Cumulative Incidence Calibration}{40}{subsection.4.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.17}{\ignorespaces Individual patient Cumulative Incidence trajectories compared against the population Aalen-Johansen baseline. The left panel illustrates extreme risk separation by plotting the four highest and four lowest-risk subjects. The right panel displays the individual trajectories of five randomly sampled subjects across the risk spectrum. The model successfully generates highly individualized, monotonic probability curves that accurately reflect subject-specific risk dynamics without violating the subdistribution boundaries.}}{41}{figure.caption.36}\protected@file@percent }
\newlabel{fig:synth_individual_cif}{{4.17}{41}{Individual patient Cumulative Incidence trajectories compared against the population Aalen-Johansen baseline. The left panel illustrates extreme risk separation by plotting the four highest and four lowest-risk subjects. The right panel displays the individual trajectories of five randomly sampled subjects across the risk spectrum. The model successfully generates highly individualized, monotonic probability curves that accurately reflect subject-specific risk dynamics without violating the subdistribution boundaries}{figure.caption.36}{}}
\newlabel{fig:synth_individual_cif@cref}{{[figure][17][4]4.17}{[1][40][]41}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4.3}Entropy Sampler Calibration and Risk Recovery}{41}{subsection.4.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.18}{\ignorespaces Model diagnostics for the optimal Entropy Sampler ($\tau =0.5$). The left panel shows superior risk score recovery (Pearson $r=0.866$) compared to the full risk-set. The right panel proves that Inverse Probability Weighting (IPW) successfully corrects selection bias, yielding highly calibrated CIF curves across all risk strata.}}{42}{figure.caption.37}\protected@file@percent }
\newlabel{fig:entropy_truth_recovery}{{4.18}{42}{Model diagnostics for the optimal Entropy Sampler ($\tau =0.5$). The left panel shows superior risk score recovery (Pearson $r=0.866$) compared to the full risk-set. The right panel proves that Inverse Probability Weighting (IPW) successfully corrects selection bias, yielding highly calibrated CIF curves across all risk strata}{figure.caption.37}{}}
\newlabel{fig:entropy_truth_recovery@cref}{{[figure][18][4]4.18}{[1][41][]42}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.19}{\ignorespaces Individual patient Cumulative Incidence trajectories generated via the Entropy sampler ($\tau =0.5$). The left panel isolates the four highest and lowest risk subjects, while the right panel displays five randomly sampled individuals. The dynamic sampling algorithm successfully preserves individual monotonicity and absolute scale without violating subdistribution limits.}}{42}{figure.caption.38}\protected@file@percent }
\newlabel{fig:entropy_individual_cif}{{4.19}{42}{Individual patient Cumulative Incidence trajectories generated via the Entropy sampler ($\tau =0.5$). The left panel isolates the four highest and lowest risk subjects, while the right panel displays five randomly sampled individuals. The dynamic sampling algorithm successfully preserves individual monotonicity and absolute scale without violating subdistribution limits}{figure.caption.38}{}}
\newlabel{fig:entropy_individual_cif@cref}{{[figure][19][4]4.19}{[1][41][]42}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4.4}Nested Case-Control (NCC) Calibration and Risk Recovery}{43}{subsection.4.4.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.20}{\ignorespaces Model diagnostics for NCC with an optimal control pool ($m=100$). The architecture successfully recovers the ground truth linear predictor (Pearson $r=0.856$) and produces highly calibrated CIF curves across all risk strata, closely matching the empirical baseline.}}{43}{figure.caption.39}\protected@file@percent }
\newlabel{fig:ncc_truth_recovery_100}{{4.20}{43}{Model diagnostics for NCC with an optimal control pool ($m=100$). The architecture successfully recovers the ground truth linear predictor (Pearson $r=0.856$) and produces highly calibrated CIF curves across all risk strata, closely matching the empirical baseline}{figure.caption.39}{}}
\newlabel{fig:ncc_truth_recovery_100@cref}{{[figure][20][4]4.20}{[1][43][]43}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.21}{\ignorespaces Model diagnostics for a heavily constrained NCC sampler ($m=5$). While rank-ordering partially survives, absolute probability calibration collapses completely. The high-risk stratum (Stratum 3, green) terminates abruptly, and the model severely underestimates the true cumulative incidence, visually explaining the Brier Score degradation observed in earlier evaluations.}}{44}{figure.caption.40}\protected@file@percent }
\newlabel{fig:ncc_truth_recovery_5}{{4.21}{44}{Model diagnostics for a heavily constrained NCC sampler ($m=5$). While rank-ordering partially survives, absolute probability calibration collapses completely. The high-risk stratum (Stratum 3, green) terminates abruptly, and the model severely underestimates the true cumulative incidence, visually explaining the Brier Score degradation observed in earlier evaluations}{figure.caption.40}{}}
\newlabel{fig:ncc_truth_recovery_5@cref}{{[figure][21][4]4.21}{[1][43][]44}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.22}{\ignorespaces Individual patient Cumulative Incidence trajectories generated via NCC ($m=100$). When provided with sufficient controls, the model retains the ability to generate stable, individualized subdistribution probabilities that scale accurately across the temporal domain.}}{44}{figure.caption.41}\protected@file@percent }
\newlabel{fig:ncc_individual_cif}{{4.22}{44}{Individual patient Cumulative Incidence trajectories generated via NCC ($m=100$). When provided with sufficient controls, the model retains the ability to generate stable, individualized subdistribution probabilities that scale accurately across the temporal domain}{figure.caption.41}{}}
\newlabel{fig:ncc_individual_cif@cref}{{[figure][22][4]4.22}{[1][43][]44}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4.5}Static Case-Cohort (SCC) Calibration and Risk Recovery}{44}{subsection.4.4.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.23}{\ignorespaces Model diagnostics for SCC with an optimal subcohort fraction ($\alpha =0.5$). The model successfully recovers the ground truth hazard (Pearson $r=0.849$) and maintains highly calibrated absolute probability estimates across all risk strata.}}{45}{figure.caption.42}\protected@file@percent }
\newlabel{fig:scc_truth_recovery_05}{{4.23}{45}{Model diagnostics for SCC with an optimal subcohort fraction ($\alpha =0.5$). The model successfully recovers the ground truth hazard (Pearson $r=0.849$) and maintains highly calibrated absolute probability estimates across all risk strata}{figure.caption.42}{}}
\newlabel{fig:scc_truth_recovery_05@cref}{{[figure][23][4]4.23}{[1][45][]45}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.24}{\ignorespaces Model diagnostics for a heavily compressed SCC sampler ($\alpha =0.05$). While rank-ordering correlation remains relatively high (Pearson $r=0.835$), the absolute calibration degrades. The Stratified CIF curves begin to diverge from the empirical baseline, particularly in the lower risk strata, indicating a breakdown in IPW scaling due to cohort sparsity.}}{45}{figure.caption.43}\protected@file@percent }
\newlabel{fig:scc_truth_recovery_05_collapse}{{4.24}{45}{Model diagnostics for a heavily compressed SCC sampler ($\alpha =0.05$). While rank-ordering correlation remains relatively high (Pearson $r=0.835$), the absolute calibration degrades. The Stratified CIF curves begin to diverge from the empirical baseline, particularly in the lower risk strata, indicating a breakdown in IPW scaling due to cohort sparsity}{figure.caption.43}{}}
\newlabel{fig:scc_truth_recovery_05_collapse@cref}{{[figure][24][4]4.24}{[1][45][]45}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.25}{\ignorespaces Individual patient Cumulative Incidence trajectories generated via SCC ($\alpha =0.5$). The fixed background cohort provides sufficient gradient stability to generate smooth, individualized subdistribution probability curves that properly scale to patient risk.}}{46}{figure.caption.44}\protected@file@percent }
\newlabel{fig:scc_individual_cif}{{4.25}{46}{Individual patient Cumulative Incidence trajectories generated via SCC ($\alpha =0.5$). The fixed background cohort provides sufficient gradient stability to generate smooth, individualized subdistribution probability curves that properly scale to patient risk}{figure.caption.44}{}}
\newlabel{fig:scc_individual_cif@cref}{{[figure][25][4]4.25}{[1][46][]46}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.5}Real-World Model Calibration and Discrimination}{46}{section.4.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5.1}Real-World Clinical Benchmark: PBC Dataset}{47}{subsection.4.5.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{Full Cohort Baseline}{47}{section*.45}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.26}{\ignorespaces Calibration diagnostics for the Full Cohort baseline on the PBC dataset. The Stratified CIF curves (left) track empirical reality across risk bounds. The Marginal Calibration plot (right) demonstrates a tight agreement between the mean model prediction and the population baseline, confirming robust absolute risk estimation without selection bias.}}{47}{figure.caption.46}\protected@file@percent }
\newlabel{fig:pbc_full_calibration}{{4.26}{47}{Calibration diagnostics for the Full Cohort baseline on the PBC dataset. The Stratified CIF curves (left) track empirical reality across risk bounds. The Marginal Calibration plot (right) demonstrates a tight agreement between the mean model prediction and the population baseline, confirming robust absolute risk estimation without selection bias}{figure.caption.46}{}}
\newlabel{fig:pbc_full_calibration@cref}{{[figure][26][4]4.26}{[1][47][]47}{}{}{}}
\@writefile{toc}{\contentsline {subsubsection}{Nested Case-Control (NCC)}{47}{section*.47}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.27}{\ignorespaces Calibration diagnostics for NCC with a large control pool ($m=100$). The model successfully replicates the Full Cohort baseline, maintaining tight Stratified CIF tracking and a minimal Marginal Calibration Gap.}}{48}{figure.caption.48}\protected@file@percent }
\newlabel{fig:pbc_ncc_100_calibration}{{4.27}{48}{Calibration diagnostics for NCC with a large control pool ($m=100$). The model successfully replicates the Full Cohort baseline, maintaining tight Stratified CIF tracking and a minimal Marginal Calibration Gap}{figure.caption.48}{}}
\newlabel{fig:pbc_ncc_100_calibration@cref}{{[figure][27][4]4.27}{[1][48][]48}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.28}{\ignorespaces Calibration diagnostics for a heavily constrained NCC sampler ($m=5$). The extreme sparsity of the control pool disrupts the IPW scaling, causing the high-risk stratum to underestimate the true incidence. Consequently, the Marginal Calibration Gap (right panel) expands severely over time as the mean model prediction detaches from the population baseline.}}{48}{figure.caption.49}\protected@file@percent }
\newlabel{fig:pbc_ncc_5_calibration}{{4.28}{48}{Calibration diagnostics for a heavily constrained NCC sampler ($m=5$). The extreme sparsity of the control pool disrupts the IPW scaling, causing the high-risk stratum to underestimate the true incidence. Consequently, the Marginal Calibration Gap (right panel) expands severely over time as the mean model prediction detaches from the population baseline}{figure.caption.49}{}}
\newlabel{fig:pbc_ncc_5_calibration@cref}{{[figure][28][4]4.28}{[1][48][]48}{}{}{}}
\@writefile{toc}{\contentsline {subsubsection}{Static Case-Cohort (SCC)}{49}{section*.50}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.29}{\ignorespaces Calibration diagnostics for SCC with an optimal subcohort fraction ($\alpha =0.5$). Even with 50\% of the data retained, the model exhibits localized deviations in the Stratified CIF curves and systematic underestimation in the Marginal Calibration Gap.}}{49}{figure.caption.51}\protected@file@percent }
\newlabel{fig:pbc_scc_50_calibration}{{4.29}{49}{Calibration diagnostics for SCC with an optimal subcohort fraction ($\alpha =0.5$). Even with 50\% of the data retained, the model exhibits localized deviations in the Stratified CIF curves and systematic underestimation in the Marginal Calibration Gap}{figure.caption.51}{}}
\newlabel{fig:pbc_scc_50_calibration@cref}{{[figure][29][4]4.29}{[1][49][]49}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.30}{\ignorespaces Calibration diagnostics for a heavily compressed SCC sampler ($\alpha =0.05$). The extreme sparsity of the static subcohort entirely destroys the IPW scaling mechanism. The model fails to recognize the baseline hazard, generating effectively flat predictions and resulting in total calibration collapse.}}{50}{figure.caption.52}\protected@file@percent }
\newlabel{fig:pbc_scc_05_calibration}{{4.30}{50}{Calibration diagnostics for a heavily compressed SCC sampler ($\alpha =0.05$). The extreme sparsity of the static subcohort entirely destroys the IPW scaling mechanism. The model fails to recognize the baseline hazard, generating effectively flat predictions and resulting in total calibration collapse}{figure.caption.52}{}}
\newlabel{fig:pbc_scc_05_calibration@cref}{{[figure][30][4]4.30}{[1][49][]50}{}{}{}}
\@writefile{toc}{\contentsline {subsubsection}{Entropy Sampler}{50}{section*.53}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.31}{\ignorespaces Calibration diagnostics for a highly greedy Entropy sampler ($\tau =0.5$). Hyper-fixating on high-variance observations in a noisy clinical dataset corrupts the IPW scaling. The model systematically underestimates absolute risk across all strata (left) and exhibits a massive Marginal Calibration Gap (right).}}{51}{figure.caption.54}\protected@file@percent }
\newlabel{fig:pbc_entropy_05_calibration}{{4.31}{51}{Calibration diagnostics for a highly greedy Entropy sampler ($\tau =0.5$). Hyper-fixating on high-variance observations in a noisy clinical dataset corrupts the IPW scaling. The model systematically underestimates absolute risk across all strata (left) and exhibits a massive Marginal Calibration Gap (right)}{figure.caption.54}{}}
\newlabel{fig:pbc_entropy_05_calibration@cref}{{[figure][31][4]4.31}{[1][50][]51}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.32}{\ignorespaces Calibration diagnostics for the optimal Entropy sampler ($\tau =5.0$). By softening the greedy sampling distribution, the IPW mechanism is restored. The model successfully recovers the Full Cohort baseline calibration, accurately tracking both the Stratified CIF curves and the population marginal average.}}{51}{figure.caption.55}\protected@file@percent }
\newlabel{fig:pbc_entropy_5_calibration}{{4.32}{51}{Calibration diagnostics for the optimal Entropy sampler ($\tau =5.0$). By softening the greedy sampling distribution, the IPW mechanism is restored. The model successfully recovers the Full Cohort baseline calibration, accurately tracking both the Stratified CIF curves and the population marginal average}{figure.caption.55}{}}
\newlabel{fig:pbc_entropy_5_calibration@cref}{{[figure][32][4]4.32}{[1][51][]51}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5.2}Real-World Semi-Synthetic: Framingham Dataset}{52}{subsection.4.5.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{Full Cohort Baseline}{52}{section*.56}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.33}{\ignorespaces Calibration diagnostics for the Full Cohort baseline on the heavily censored Framingham dataset. The model maintains tight Stratified CIF tracking (left) and exhibits no marginal calibration gap (right), successfully isolating the baseline hazard despite low event density.}}{52}{figure.caption.57}\protected@file@percent }
\newlabel{fig:fh_full_calibration}{{4.33}{52}{Calibration diagnostics for the Full Cohort baseline on the heavily censored Framingham dataset. The model maintains tight Stratified CIF tracking (left) and exhibits no marginal calibration gap (right), successfully isolating the baseline hazard despite low event density}{figure.caption.57}{}}
\newlabel{fig:fh_full_calibration@cref}{{[figure][33][4]4.33}{[1][52][]52}{}{}{}}
\@writefile{toc}{\contentsline {subsubsection}{Nested Case-Control (NCC)}{53}{section*.58}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.34}{\ignorespaces Calibration diagnostics for NCC on the Framingham dataset. Both the optimal control pool ($m=100$, top) and the heavily constrained pool ($m=5$, bottom) maintain excellent absolute calibration. The high censoring rate inherently limits the variance of the background risk-set, preventing the IPW collapse observed in the Synthetic and PBC datasets.}}{53}{figure.caption.59}\protected@file@percent }
\newlabel{fig:fh_ncc_calibration}{{4.34}{53}{Calibration diagnostics for NCC on the Framingham dataset. Both the optimal control pool ($m=100$, top) and the heavily constrained pool ($m=5$, bottom) maintain excellent absolute calibration. The high censoring rate inherently limits the variance of the background risk-set, preventing the IPW collapse observed in the Synthetic and PBC datasets}{figure.caption.59}{}}
\newlabel{fig:fh_ncc_calibration@cref}{{[figure][34][4]4.34}{[1][53][]53}{}{}{}}
\@writefile{toc}{\contentsline {subsubsection}{Static Case-Cohort (SCC)}{54}{section*.60}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.35}{\ignorespaces Calibration diagnostics for SCC on the Framingham dataset. While the optimal subcohort ($\alpha =0.5$) maintains baseline calibration, extreme compression ($\alpha =0.05$) reveals a structural vulnerability. The static subcohort fails to represent the temporal hazard over the long 3,500-day timeline, leading to an expanding calibration gap.}}{54}{figure.caption.61}\protected@file@percent }
\newlabel{fig:fh_scc_calibration}{{4.35}{54}{Calibration diagnostics for SCC on the Framingham dataset. While the optimal subcohort ($\alpha =0.5$) maintains baseline calibration, extreme compression ($\alpha =0.05$) reveals a structural vulnerability. The static subcohort fails to represent the temporal hazard over the long 3,500-day timeline, leading to an expanding calibration gap}{figure.caption.61}{}}
\newlabel{fig:fh_scc_calibration@cref}{{[figure][35][4]4.35}{[1][54][]54}{}{}{}}
\@writefile{toc}{\contentsline {subsubsection}{Entropy Sampler}{55}{section*.62}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.36}{\ignorespaces Calibration diagnostics for a greedy Entropy sampler ($\tau =0.5$) on the Framingham dataset. By hyper-focusing on rare events and down-weighting censored observations, the IPW scaling becomes distorted. The model overestimates high-risk incidence (left, solid green line) and systematically underestimates the marginal population average (right).}}{55}{figure.caption.63}\protected@file@percent }
\newlabel{fig:fh_entropy_05_calibration}{{4.36}{55}{Calibration diagnostics for a greedy Entropy sampler ($\tau =0.5$) on the Framingham dataset. By hyper-focusing on rare events and down-weighting censored observations, the IPW scaling becomes distorted. The model overestimates high-risk incidence (left, solid green line) and systematically underestimates the marginal population average (right)}{figure.caption.63}{}}
\newlabel{fig:fh_entropy_05_calibration@cref}{{[figure][36][4]4.36}{[1][55][]55}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.37}{\ignorespaces Calibration diagnostics for the optimally tuned Entropy sampler ($\tau =5.0$). Softening the probability distribution allows the model to retain sufficient censored observations to anchor the baseline hazard. The IPW mechanism is restored, yielding near-perfect Stratified CIF tracking and eliminating the Marginal Calibration Gap.}}{56}{figure.caption.64}\protected@file@percent }
\newlabel{fig:fh_entropy_5_calibration}{{4.37}{56}{Calibration diagnostics for the optimally tuned Entropy sampler ($\tau =5.0$). Softening the probability distribution allows the model to retain sufficient censored observations to anchor the baseline hazard. The IPW mechanism is restored, yielding near-perfect Stratified CIF tracking and eliminating the Marginal Calibration Gap}{figure.caption.64}{}}
\newlabel{fig:fh_entropy_5_calibration@cref}{{[figure][37][4]4.37}{[1][56][]56}{}{}{}}
